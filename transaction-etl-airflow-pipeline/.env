AIRFLOW_UID=1000

# Airflow security / auth
# Keep blank to preserve current local behavior unless you intentionally set a Fernet key.
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# Airflow metadata database
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Airflow admin account
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Warehouse PostgreSQL
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse
WAREHOUSE_DB=datawarehouse

# Source PostgreSQL
SOURCE_DB_USER=source_user
SOURCE_DB_PASSWORD=source_pass
SOURCE_DB_NAME=transactions_db

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=root
COMPOSE_PROJECT_NAME=model-2-airflow