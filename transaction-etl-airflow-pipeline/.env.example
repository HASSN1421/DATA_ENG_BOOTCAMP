AIRFLOW_UID=1000

# Airflow security / auth
FERNET_KEY=your_fernet_key
AIRFLOW__API_AUTH__JWT_SECRET=your_jwt_secret
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# Airflow metadata database
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=your_airflow_db_password
AIRFLOW_DB_NAME=airflow

# Airflow admin account
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=your_airflow_admin_password

# Warehouse PostgreSQL
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=your_warehouse_password
WAREHOUSE_DB=datawarehouse

# Source PostgreSQL
SOURCE_DB_USER=source_user
SOURCE_DB_PASSWORD=your_source_db_password
SOURCE_DB_NAME=transactions_db

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=your_pgadmin_password
